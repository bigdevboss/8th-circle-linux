start:
    loada M8_ARGC
    storea argc_value
    cmpm one
    branchz no_text
    seta 1
    storea arg_idx
arg_loop:
    loada arg_idx
    cmpm argc_value
    branchz done
    loada arg_idx
    cmpm one
    branchz no_space
    trap write 1 space space_end-space
no_space:
    seta after_arg_ptr
    storea argv_ret
    jump get_argv_ptr
after_arg_ptr:
    storea arg_ptr
    seta after_copy_arg
    storea copy_ret
    jump copy_arg
after_copy_arg:
    trap write 1 arg_buf A
    loada arg_idx
    addi 1
    storea arg_idx
    jump arg_loop
no_text:
done:
    trap write 1 newline newline_end-newline
    trap exit 0

get_argv_ptr:
    loada M8_ARGV
    addm arg_idx
    storea scratch_ptr
    loadi scratch_ptr
    jumpm argv_ret

copy_arg:
    loada arg_ptr
    storea src_ptr
    seta arg_buf
    storea dst_ptr
    seta 0
    storea idx
copy_loop:
    loada idx
    cmpm arg_limit
    branchz copy_done
    loadi src_ptr
    branchz copy_done
    storei dst_ptr
    loada src_ptr
    addi 1
    storea src_ptr
    loada dst_ptr
    addi 1
    storea dst_ptr
    loada idx
    addi 1
    storea idx
    jump copy_loop
copy_done:
    seta 0
    storei dst_ptr
    loada idx
    jumpm copy_ret

space:
    ascii " "
space_end:
newline:
    ascii "\n"
newline_end:
one:
    word 1
arg_limit:
    word 511
argc_value:
    word 0
arg_idx:
    word 0
arg_ptr:
    word 0
argv_ret:
    word 0
copy_ret:
    word 0
src_ptr:
    word 0
dst_ptr:
    word 0
idx:
    word 0
scratch_ptr:
    word 0
arg_buf:
    zero 512
