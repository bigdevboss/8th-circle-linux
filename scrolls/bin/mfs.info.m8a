start:
    seta after_load
    storea mfs_ret
    jump mfs_load
after_load:
    loada mfs_status
    branchnz failed
    trap write 1 title_msg title_msg_end-title_msg
    trap write 1 entries_label entries_label_end-entries_label
    seta after_print_entries
    storea print_ret
    loada mfs_buf+12
    jump print_dec
after_print_entries:
    trap write 1 newline newline_end-newline
    trap write 1 image_size_label image_size_label_end-image_size_label
    seta after_print_image_size
    storea print_ret
    loada mfs_len
    jump print_dec
after_print_image_size:
    trap write 1 newline newline_end-newline
    trap write 1 entry_size_label entry_size_label_end-entry_size_label
    seta after_print_entry_size
    storea print_ret
    loada mfs_buf+28
    jump print_dec
after_print_entry_size:
    trap write 1 newline newline_end-newline
    trap write 1 files_label files_label_end-files_label
    seta mfs_buf+512
    storea mfs_entry_ptr
    seta info_after_0
    storea mfs_name_ret
    jump mfs_copy_name
info_after_0:
    seta mfs_buf+640
    storea mfs_entry_ptr
    seta info_after_1
    storea mfs_name_ret
    jump mfs_copy_name
info_after_1:
    seta mfs_buf+768
    storea mfs_entry_ptr
    seta info_after_2
    storea mfs_name_ret
    jump mfs_copy_name
info_after_2:
    seta mfs_buf+896
    storea mfs_entry_ptr
    seta info_after_3
    storea mfs_name_ret
    jump mfs_copy_name
info_after_3:
    seta mfs_buf+1024
    storea mfs_entry_ptr
    seta info_after_4
    storea mfs_name_ret
    jump mfs_copy_name
info_after_4:
    seta mfs_buf+1152
    storea mfs_entry_ptr
    seta info_after_5
    storea mfs_name_ret
    jump mfs_copy_name
info_after_5:
    seta mfs_buf+1280
    storea mfs_entry_ptr
    seta info_after_6
    storea mfs_name_ret
    jump mfs_copy_name
info_after_6:
    seta mfs_buf+1408
    storea mfs_entry_ptr
    seta info_after_7
    storea mfs_name_ret
    jump mfs_copy_name
info_after_7:
    seta mfs_buf+1536
    storea mfs_entry_ptr
    seta info_after_8
    storea mfs_name_ret
    jump mfs_copy_name
info_after_8:
    seta mfs_buf+1664
    storea mfs_entry_ptr
    seta info_after_9
    storea mfs_name_ret
    jump mfs_copy_name
info_after_9:
    seta mfs_buf+1792
    storea mfs_entry_ptr
    seta info_after_10
    storea mfs_name_ret
    jump mfs_copy_name
info_after_10:
    seta mfs_buf+1920
    storea mfs_entry_ptr
    seta info_after_11
    storea mfs_name_ret
    jump mfs_copy_name
info_after_11:
    seta mfs_buf+2048
    storea mfs_entry_ptr
    seta info_after_12
    storea mfs_name_ret
    jump mfs_copy_name
info_after_12:
    seta mfs_buf+2176
    storea mfs_entry_ptr
    seta info_after_13
    storea mfs_name_ret
    jump mfs_copy_name
info_after_13:
    seta mfs_buf+2304
    storea mfs_entry_ptr
    seta info_after_14
    storea mfs_name_ret
    jump mfs_copy_name
info_after_14:
    seta mfs_buf+2432
    storea mfs_entry_ptr
    seta info_after_15
    storea mfs_name_ret
    jump mfs_copy_name
info_after_15:
done:
    trap exit 0
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

mfs_load:
    trap open mfs_image_path 0 0
    brancherr mfs_load_fail
    storea mfs_fd
    trap read A mfs_buf 8192
    brancherr mfs_load_close_fail
    storea mfs_len
    loada mfs_fd
    trap close A
    seta 0
    storea mfs_status
    loada mfs_len
    jumpm mfs_ret
mfs_load_close_fail:
    loada mfs_fd
    trap close A
mfs_load_fail:
    seta 1
    storea mfs_status
    seta 0
    jumpm mfs_ret

mfs_copy_name:
    loada mfs_entry_ptr
    storea src_ptr
    loadi src_ptr
    branchz mfs_copy_name_done
mfs_copy_name_loop:
    storea name_scratch
    trap write 1 name_scratch 1
    loada src_ptr
    addi 1
    storea src_ptr
    loadi src_ptr
    branchz mfs_copy_name_nl
    jump mfs_copy_name_loop
mfs_copy_name_nl:
    trap write 1 newline newline_end-newline
    seta 1
mfs_copy_name_done:
    jumpm mfs_name_ret

include "../lib/print_fdec.m8a"


title_msg:
    ascii "MFS8 v1 image\n"
title_msg_end:
entries_label:
    ascii "entries: "
entries_label_end:
image_size_label:
    ascii "image-size: "
image_size_label_end:
entry_size_label:
    ascii "entry-size: "
entry_size_label_end:
files_label:
    ascii "files:\n"
files_label_end:
newline:
    ascii "\n"
newline_end:
failed_msg:
    ascii "mfs.info: failed\n"
failed_msg_end:
mfs_image_path:
    cstring "/mfs/root.mfs"
mfs_fd:
    word 0
mfs_len:
    word 0
mfs_status:
    word 0
mfs_ret:
    word 0
print_ret:
    word 0
mfs_entry_ptr:
    word 0
mfs_name_ret:
    word 0
digit_hundreds:
    word 0
src_ptr:
    word 0
name_scratch:
    word 0
mfs_buf:
    zero 8192
