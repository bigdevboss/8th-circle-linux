start:
    seta after_load
    storea mfs_ret
    jump mfs_load
after_load:
    loada mfs_status
    branchnz failed
    trap write 1 title_msg title_msg_end-title_msg
    seta mfs_buf+12
    storea u16_ptr
    seta after_entry_count
    storea u16_ret
    jump read_u16
after_entry_count:
    storea mfs_entry_count
    trap write 1 entries_label entries_label_end-entries_label
    seta after_print_entries
    storea print_ret
    loada mfs_entry_count
    jump print_dec
after_print_entries:
    trap write 1 newline newline_end-newline
    seta mfs_buf+24
    storea u16_ptr
    seta after_image_size
    storea u16_ret
    jump read_u16
after_image_size:
    storea mfs_image_size
    trap write 1 image_size_label image_size_label_end-image_size_label
    seta after_print_image_size
    storea print_ret
    loada mfs_image_size
    jump print_dec
after_print_image_size:
    trap write 1 newline newline_end-newline
    seta mfs_buf+28
    storea u16_ptr
    seta after_entry_size
    storea u16_ret
    jump read_u16
after_entry_size:
    storea mfs_entry_size
    trap write 1 entry_size_label entry_size_label_end-entry_size_label
    seta after_print_entry_size
    storea print_ret
    loada mfs_entry_size
    jump print_dec
after_print_entry_size:
    trap write 1 newline newline_end-newline
    trap write 1 files_label files_label_end-files_label
    seta mfs_buf+512
    storea mfs_entry_ptr
    seta 0
    storea mfs_entry_idx
entry_loop:
    loada mfs_entry_idx
    cmpm mfs_entry_count
    branchz done
    seta after_name
    storea mfs_name_ret
    jump mfs_copy_name
after_name:
next_entry:
    loada mfs_entry_ptr
    addi 128
    storea mfs_entry_ptr
    loada mfs_entry_idx
    addi 1
    storea mfs_entry_idx
    jump entry_loop
done:
    trap exit 0
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

mfs_load:
    trap open mfs_image_path 0 0
    brancherr mfs_load_fail
    storea mfs_fd
    trap read A mfs_buf 8192
    brancherr mfs_load_close_fail
    storea mfs_len
    loada mfs_fd
    trap close A
    seta 0
    storea mfs_status
    loada mfs_len
    jumpm mfs_ret
mfs_load_close_fail:
    loada mfs_fd
    trap close A
mfs_load_fail:
    seta 1
    storea mfs_status
    seta 0
    jumpm mfs_ret

mfs_copy_name:
    loada mfs_entry_ptr
    storea src_ptr
    loadi src_ptr
    branchz mfs_copy_name_done
mfs_copy_name_loop:
    storea name_scratch
    trap write 1 name_scratch 1
    loada src_ptr
    addi 1
    storea src_ptr
    loadi src_ptr
    branchz mfs_copy_name_nl
    jump mfs_copy_name_loop
mfs_copy_name_nl:
    trap write 1 newline newline_end-newline
    seta 1
mfs_copy_name_done:
    jumpm mfs_name_ret

read_u16:
    loadi u16_ptr
    storea u16_value
    loada u16_ptr
    addi 1
    storea scratch_ptr
    loadi scratch_ptr
    storea u16_high
read_u16_loop:
    loada u16_high
    branchz read_u16_done
    loada u16_value
    addi 256
    storea u16_value
    loada u16_high
    subi 1
    storea u16_high
    jump read_u16_loop
read_u16_done:
    loada u16_value
    jumpm u16_ret

print_dec:
    storea num_value
    seta 0
    storea digit_ones
    storea digit_tens
    storea digit_hundreds
    storea digit_thousands
    storea digit_tenthousands
    storea seen_digit
    loada num_value
    branchz print_zero
print_dec_loop:
    loada num_value
    branchz print_dec_emit
    subi 1
    storea num_value
    loada digit_ones
    addi 1
    storea digit_ones
    cmpm ten
    branchz carry_tens
    jump print_dec_loop
carry_tens:
    seta 0
    storea digit_ones
    loada digit_tens
    addi 1
    storea digit_tens
    cmpm ten
    branchz carry_hundreds
    jump print_dec_loop
carry_hundreds:
    seta 0
    storea digit_tens
    loada digit_hundreds
    addi 1
    storea digit_hundreds
    cmpm ten
    branchz carry_thousands
    jump print_dec_loop
carry_thousands:
    seta 0
    storea digit_hundreds
    loada digit_thousands
    addi 1
    storea digit_thousands
    cmpm ten
    branchz carry_tenthousands
    jump print_dec_loop
carry_tenthousands:
    seta 0
    storea digit_thousands
    loada digit_tenthousands
    addi 1
    storea digit_tenthousands
    jump print_dec_loop
print_zero:
    seta 48
    storea digit_char
    trap write 1 digit_char 1
    jumpm print_ret
print_dec_emit:
    loada digit_tenthousands
    branchz print_10000_maybe_skip
    seta 1
    storea seen_digit
    loada digit_tenthousands
    addi 48
    storea digit_char
    trap write 1 digit_char 1
    jump print_1000
print_10000_maybe_skip:
    loada seen_digit
    branchz print_1000
    loada digit_tenthousands
    addi 48
    storea digit_char
    trap write 1 digit_char 1
print_1000:
    loada digit_thousands
    branchz print_1000_maybe_skip
    seta 1
    storea seen_digit
    loada digit_thousands
    addi 48
    storea digit_char
    trap write 1 digit_char 1
    jump print_100
print_1000_maybe_skip:
    loada seen_digit
    branchz print_100
    loada digit_thousands
    addi 48
    storea digit_char
    trap write 1 digit_char 1
print_100:
    loada digit_hundreds
    branchz print_100_maybe_skip
    seta 1
    storea seen_digit
    loada digit_hundreds
    addi 48
    storea digit_char
    trap write 1 digit_char 1
    jump print_10
print_100_maybe_skip:
    loada seen_digit
    branchz print_10
    loada digit_hundreds
    addi 48
    storea digit_char
    trap write 1 digit_char 1
print_10:
    loada digit_tens
    branchz print_10_maybe_skip
    seta 1
    storea seen_digit
    loada digit_tens
    addi 48
    storea digit_char
    trap write 1 digit_char 1
    jump print_1
print_10_maybe_skip:
    loada seen_digit
    branchz print_1
    loada digit_tens
    addi 48
    storea digit_char
    trap write 1 digit_char 1
print_1:
    loada digit_ones
    addi 48
    storea digit_char
    trap write 1 digit_char 1
    jumpm print_ret

title_msg:
    ascii "MFS8 v0 image\n"
title_msg_end:
entries_label:
    ascii "entries: "
entries_label_end:
image_size_label:
    ascii "image-size: "
image_size_label_end:
entry_size_label:
    ascii "entry-size: "
entry_size_label_end:
files_label:
    ascii "files:\n"
files_label_end:
newline:
    ascii "\n"
newline_end:
failed_msg:
    ascii "mfs.info: failed\n"
failed_msg_end:
mfs_image_path:
    cstring "/mfs/root.mfs"
ten:
    word 10
mfs_fd:
    word 0
mfs_len:
    word 0
mfs_status:
    word 0
mfs_ret:
    word 0
mfs_entry_count:
    word 0
mfs_entry_size:
    word 0
mfs_image_size:
    word 0
mfs_entry_idx:
    word 0
mfs_entry_ptr:
    word 0
mfs_name_ret:
    word 0
u16_ptr:
    word 0
u16_ret:
    word 0
u16_value:
    word 0
u16_high:
    word 0
print_ret:
    word 0
num_value:
    word 0
seen_digit:
    word 0
digit_ones:
    word 0
digit_tens:
    word 0
digit_hundreds:
    word 0
digit_thousands:
    word 0
digit_tenthousands:
    word 0
digit_char:
    word 0
src_ptr:
    word 0
name_scratch:
    word 0
scratch_ptr:
    word 0
mfs_buf:
    zero 8192
