done:
    trap write 1 newline newline_end-newline
    trap exit 0

copy_str:
    loadi src_ptr
    branchz copy_done
    storea byte_scratch
    trap write 1 byte_scratch 1
    loada src_ptr
    addi 1
    storea src_ptr
    jump copy_str
copy_done:
    jumpm copy_ret

space:
    ascii " "
space_end:
newline:
    ascii "\n"
newline_end:
printed_any:
    word 0
copy_ret:
    word 0
src_ptr:
    word 0
byte_scratch:
    word 0
