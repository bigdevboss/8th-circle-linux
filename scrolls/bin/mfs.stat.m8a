start:
    seta after_arg
    storea arg_ret
    jump copy_arg1
after_arg:
    branchz usage
    storea path_len
    seta after_load
    storea mfs_ret
    jump mfs_load
after_load:
    loada mfs_status
    branchnz failed
stat_try_0:
    seta mfs_buf+512
    storea mfs_entry_ptr
    seta stat_after_0
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_0:
    branchnz stat_found_0
stat_try_1:
    seta mfs_buf+640
    storea mfs_entry_ptr
    seta stat_after_1
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_1:
    branchnz stat_found_1
stat_try_2:
    seta mfs_buf+768
    storea mfs_entry_ptr
    seta stat_after_2
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_2:
    branchnz stat_found_2
stat_try_3:
    seta mfs_buf+896
    storea mfs_entry_ptr
    seta stat_after_3
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_3:
    branchnz stat_found_3
stat_try_4:
    seta mfs_buf+1024
    storea mfs_entry_ptr
    seta stat_after_4
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_4:
    branchnz stat_found_4
stat_try_5:
    seta mfs_buf+1152
    storea mfs_entry_ptr
    seta stat_after_5
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_5:
    branchnz stat_found_5
stat_try_6:
    seta mfs_buf+1280
    storea mfs_entry_ptr
    seta stat_after_6
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_6:
    branchnz stat_found_6
stat_try_7:
    seta mfs_buf+1408
    storea mfs_entry_ptr
    seta stat_after_7
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_7:
    branchnz stat_found_7
stat_try_8:
    seta mfs_buf+1536
    storea mfs_entry_ptr
    seta stat_after_8
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_8:
    branchnz stat_found_8
stat_try_9:
    seta mfs_buf+1664
    storea mfs_entry_ptr
    seta stat_after_9
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_9:
    branchnz stat_found_9
stat_try_10:
    seta mfs_buf+1792
    storea mfs_entry_ptr
    seta stat_after_10
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_10:
    branchnz stat_found_10
stat_try_11:
    seta mfs_buf+1920
    storea mfs_entry_ptr
    seta stat_after_11
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_11:
    branchnz stat_found_11
stat_try_12:
    seta mfs_buf+2048
    storea mfs_entry_ptr
    seta stat_after_12
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_12:
    branchnz stat_found_12
stat_try_13:
    seta mfs_buf+2176
    storea mfs_entry_ptr
    seta stat_after_13
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_13:
    branchnz stat_found_13
stat_try_14:
    seta mfs_buf+2304
    storea mfs_entry_ptr
    seta stat_after_14
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_14:
    branchnz stat_found_14
stat_try_15:
    seta mfs_buf+2432
    storea mfs_entry_ptr
    seta stat_after_15
    storea mfs_match_ret
    jump mfs_name_matches_path
stat_after_15:
    branchnz stat_found_15
    jump not_found
stat_found_0:
    loada mfs_entry_0_size
    storea stat_size
    loada mfs_entry_0_offset
    storea stat_offset
    jump stat_print_meta
stat_found_1:
    loada mfs_entry_1_size
    storea stat_size
    loada mfs_entry_1_offset
    storea stat_offset
    jump stat_print_meta
stat_found_2:
    loada mfs_entry_2_size
    storea stat_size
    loada mfs_entry_2_offset
    storea stat_offset
    jump stat_print_meta
stat_found_3:
    loada mfs_entry_3_size
    storea stat_size
    loada mfs_entry_3_offset
    storea stat_offset
    jump stat_print_meta
stat_found_4:
    loada mfs_entry_4_size
    storea stat_size
    loada mfs_entry_4_offset
    storea stat_offset
    jump stat_print_meta
stat_found_5:
    loada mfs_entry_5_size
    storea stat_size
    loada mfs_entry_5_offset
    storea stat_offset
    jump stat_print_meta
stat_found_6:
    loada mfs_entry_6_size
    storea stat_size
    loada mfs_entry_6_offset
    storea stat_offset
    jump stat_print_meta
stat_found_7:
    loada mfs_entry_7_size
    storea stat_size
    loada mfs_entry_7_offset
    storea stat_offset
    jump stat_print_meta
stat_found_8:
    loada mfs_entry_8_size
    storea stat_size
    loada mfs_entry_8_offset
    storea stat_offset
    jump stat_print_meta
stat_found_9:
    loada mfs_entry_9_size
    storea stat_size
    loada mfs_entry_9_offset
    storea stat_offset
    jump stat_print_meta
stat_found_10:
    loada mfs_entry_10_size
    storea stat_size
    loada mfs_entry_10_offset
    storea stat_offset
    jump stat_print_meta
stat_found_11:
    loada mfs_entry_11_size
    storea stat_size
    loada mfs_entry_11_offset
    storea stat_offset
    jump stat_print_meta
stat_found_12:
    loada mfs_entry_12_size
    storea stat_size
    loada mfs_entry_12_offset
    storea stat_offset
    jump stat_print_meta
stat_found_13:
    loada mfs_entry_13_size
    storea stat_size
    loada mfs_entry_13_offset
    storea stat_offset
    jump stat_print_meta
stat_found_14:
    loada mfs_entry_14_size
    storea stat_size
    loada mfs_entry_14_offset
    storea stat_offset
    jump stat_print_meta
stat_found_15:
    loada mfs_entry_15_size
    storea stat_size
    loada mfs_entry_15_offset
    storea stat_offset
    jump stat_print_meta
stat_print_meta:
    trap write 1 name_label name_label_end-name_label
    loada path_len
    trap write 1 path_buf A
    trap write 1 newline newline_end-newline
    trap write 1 size_label size_label_end-size_label
    seta after_print_size
    storea print_ret
    loada stat_size
    jump print_dec
after_print_size:
    trap write 1 newline newline_end-newline
    trap write 1 offset_label offset_label_end-offset_label
    seta after_print_offset
    storea print_ret
    loada stat_offset
    jump print_dec
after_print_offset:
    trap write 1 newline newline_end-newline
    trap exit 0
usage:
    trap write 2 usage_msg usage_msg_end-usage_msg
    trap exit 2
not_found:
    trap write 2 not_found_msg not_found_msg_end-not_found_msg
    trap exit 1
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

copy_arg1:
    loada M8_ARGVEC+1
    branchz arg_missing
    storea src_ptr
    seta path_buf
    storea dst_ptr
    seta 0
    storea idx
copy_arg_loop:
    loada idx
    cmpm path_limit
    branchz copy_arg_done
    loadi src_ptr
    branchz copy_arg_done
    storei dst_ptr
    loada src_ptr
    addi 1
    storea src_ptr
    loada dst_ptr
    addi 1
    storea dst_ptr
    loada idx
    addi 1
    storea idx
    jump copy_arg_loop
copy_arg_done:
    seta 0
    storei dst_ptr
    loada idx
    jumpm arg_ret
arg_missing:
    seta 0
    jumpm arg_ret

mfs_load:
    trap open mfs_image_path 0 0
    brancherr mfs_load_fail
    storea mfs_fd
    trap read A mfs_buf 8192
    brancherr mfs_load_close_fail
    storea mfs_len
    loada mfs_fd
    trap close A
    seta 0
    storea mfs_status
    loada mfs_len
    jumpm mfs_ret
mfs_load_close_fail:
    loada mfs_fd
    trap close A
mfs_load_fail:
    seta 1
    storea mfs_status
    seta 0
    jumpm mfs_ret

mfs_name_matches_path:
    loada mfs_entry_ptr
    storea src_ptr
    seta path_buf
    storea pat_ptr
match_loop:
    loadi src_ptr
    storea tmp_ch
    loadi pat_ptr
    cmpm tmp_ch
    branchz match_chars_equal
match_fail:
    seta 0
    jumpm mfs_match_ret
match_chars_equal:
    loada tmp_ch
    branchz match_success
    loada src_ptr
    addi 1
    storea src_ptr
    loada pat_ptr
    addi 1
    storea pat_ptr
    jump match_loop
match_success:
    seta 1
    jumpm mfs_match_ret

include "../lib/print_fdec.m8a"


usage_msg:
    ascii "usage: mfscat NAME\n"
usage_msg_end:
not_found_msg:
    ascii "mfs.stat: not found\n"
not_found_msg_end:
failed_msg:
    ascii "mfs.stat: failed\n"
failed_msg_end:
name_label:
    ascii "name: "
name_label_end:
size_label:
    ascii "size: "
size_label_end:
offset_label:
    ascii "offset: "
offset_label_end:
newline:
    ascii "\n"
newline_end:
mfs_image_path:
    cstring "/mfs/root.mfs"
path_limit:
    word 511
arg_ret:
    word 0
path_len:
    word 0
mfs_fd:
    word 0
mfs_len:
    word 0
mfs_status:
    word 0
mfs_ret:
    word 0
print_ret:
    word 0
mfs_entry_ptr:
    word 0
mfs_match_ret:
    word 0
stat_size:
    word 0
stat_offset:
    word 0
digit_hundreds:
    word 0
src_ptr:
    word 0
pat_ptr:
    word 0
dst_ptr:
    word 0
idx:
    word 0
tmp_ch:
    word 0
path_buf:
    zero 512
mfs_buf:
    zero 8192

include "../../src/userland/mfs-manifest.m8a"
