    branchnz failed
    jump done
done:
    trap exit 0
usage:
    trap write 2 usage_msg usage_msg_end-usage_msg
    trap exit 2
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

cat_one:
    loada path_ptr
    trap open A 0 0
    brancherr cat_open_failed
    storea fd
cat_read_loop:
    loada fd
    trap read A file_buf 512
    brancherr cat_read_failed
    branchz cat_close_ok
    trap write 1 file_buf A
    jump cat_read_loop
cat_close_ok:
    loada fd
    trap close A
    seta 0
    storea cat_status
    jumpm cat_ret
cat_read_failed:
    loada fd
    trap close A
cat_open_failed:
    seta 1
    storea cat_status
    jumpm cat_ret

usage_msg:
    ascii "usage: cat PATH...\n"
usage_msg_end:
failed_msg:
    ascii "cat: failed\n"
failed_msg_end:
argv_slot_1:
