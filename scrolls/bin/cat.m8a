start:
    loada M8_ARGC
    storea argc_value
    cmpm one
    branchz usage
    seta 1
    storea arg_idx
cat_arg_loop:
    loada arg_idx
    cmpm argc_value
    branchz done
    seta after_arg_ptr
    storea argv_ret
    jump get_argv_ptr
after_arg_ptr:
    storea path_ptr
    seta after_cat_one
    storea cat_ret
    jump cat_one
after_cat_one:
    loada cat_status
    branchnz failed
    loada arg_idx
    addi 1
    storea arg_idx
    jump cat_arg_loop
done:
    trap exit 0
usage:
    trap write 2 usage_msg usage_msg_end-usage_msg
    trap exit 2
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

get_argv_ptr:
    loada M8_ARGV
    addm arg_idx
    storea scratch_ptr
    loadi scratch_ptr
    jumpm argv_ret

cat_one:
    loada path_ptr
    trap open A 0 0
    brancherr cat_open_failed
    storea fd
cat_read_loop:
    loada fd
    trap read A file_buf 512
    brancherr cat_read_failed
    branchz cat_close_ok
    trap write 1 file_buf A
    jump cat_read_loop
cat_close_ok:
    loada fd
    trap close A
    seta 0
    storea cat_status
    jumpm cat_ret
cat_read_failed:
    loada fd
    trap close A
cat_open_failed:
    seta 1
    storea cat_status
    jumpm cat_ret

usage_msg:
    ascii "usage: cat PATH...\n"
usage_msg_end:
failed_msg:
    ascii "cat: failed\n"
failed_msg_end:
one:
    word 1
argc_value:
    word 0
arg_idx:
    word 0
path_ptr:
    word 0
argv_ret:
    word 0
cat_ret:
    word 0
cat_status:
    word 0
fd:
    word 0
scratch_ptr:
    word 0
file_buf:
    zero 512
