    storea mfs_entry_ptr
    seta cat_after_7
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_7:
    branchnz cat_found_7
cat_try_8:
    seta mfs_buf+1536
    storea mfs_entry_ptr
    seta cat_after_8
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_8:
