    storea mfs_entry_ptr
    seta cat_after_9
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_9:
    branchnz cat_found_9
cat_try_10:
    seta mfs_buf+1792
    storea mfs_entry_ptr
    seta cat_after_10
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_10:
    branchnz cat_found_10
cat_try_11:
    seta mfs_buf+1920
    storea mfs_entry_ptr
    seta cat_after_11
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_11:
    branchnz cat_found_11
cat_try_12:
    seta mfs_buf+2048
    storea mfs_entry_ptr
    seta cat_after_12
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_12:
    branchnz cat_found_12
cat_try_13:
    seta mfs_buf+2176
    storea mfs_entry_ptr
    seta cat_after_13
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_13:
    branchnz cat_found_13
cat_try_14:
    seta mfs_buf+2304
    storea mfs_entry_ptr
    seta cat_after_14
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_14:
    branchnz cat_found_14
cat_try_15:
    seta mfs_buf+2432
    storea mfs_entry_ptr
    seta cat_after_15
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_15:
    branchnz cat_found_15
    jump failed
cat_found_0:
    loada mfs_entry_0_src
    storea src_ptr
    loada mfs_entry_0_end
    storea payload_end
    jump cat_print_payload
cat_found_1:
    loada mfs_entry_1_src
    storea src_ptr
    loada mfs_entry_1_end
    storea payload_end
    jump cat_print_payload
cat_found_2:
    loada mfs_entry_2_src
    storea src_ptr
    loada mfs_entry_2_end
    storea payload_end
    jump cat_print_payload
cat_found_3:
    loada mfs_entry_3_src
    storea src_ptr
    loada mfs_entry_3_end
    storea payload_end
    jump cat_print_payload
cat_found_4:
    loada mfs_entry_4_src
    storea src_ptr
    loada mfs_entry_4_end
    storea payload_end
    jump cat_print_payload
cat_found_5:
    loada mfs_entry_5_src
    storea src_ptr
    loada mfs_entry_5_end
    storea payload_end
    jump cat_print_payload
cat_found_6:
    loada mfs_entry_6_src
    storea src_ptr
    loada mfs_entry_6_end
    storea payload_end
    jump cat_print_payload
cat_found_7:
    loada mfs_entry_7_src
    storea src_ptr
    loada mfs_entry_7_end
    storea payload_end
    jump cat_print_payload
cat_found_8:
    loada mfs_entry_8_src
    storea src_ptr
    loada mfs_entry_8_end
    storea payload_end
    jump cat_print_payload
cat_found_9:
    loada mfs_entry_9_src
    storea src_ptr
    loada mfs_entry_9_end
    storea payload_end
    jump cat_print_payload
cat_found_10:
    loada mfs_entry_10_src
    storea src_ptr
    loada mfs_entry_10_end
    storea payload_end
    jump cat_print_payload
cat_found_11:
    loada mfs_entry_11_src
    storea src_ptr
    loada mfs_entry_11_end
    storea payload_end
    jump cat_print_payload
cat_found_12:
    loada mfs_entry_12_src
    storea src_ptr
    loada mfs_entry_12_end
    storea payload_end
    jump cat_print_payload
cat_found_13:
    loada mfs_entry_13_src
    storea src_ptr
    loada mfs_entry_13_end
    storea payload_end
    jump cat_print_payload
cat_found_14:
    loada mfs_entry_14_src
    storea src_ptr
    loada mfs_entry_14_end
    storea payload_end
    jump cat_print_payload
cat_found_15:
    loada mfs_entry_15_src
    storea src_ptr
    loada mfs_entry_15_end
    storea payload_end
    jump cat_print_payload
cat_print_payload:
    loada src_ptr
    cmpm payload_end
    branchz cat_payload_done
    loadi src_ptr
    storea out_byte
    trap write 1 out_byte 1
    loada src_ptr
    addi 1
    storea src_ptr
    jump cat_print_payload
cat_payload_done:
    trap exit 0
usage:
    trap write 2 usage_msg usage_msg_end-usage_msg
    trap exit 2
failed:
    trap write 2 failed_msg failed_msg_end-failed_msg
    trap exit 1

copy_arg1:
    loada M8_ARGVEC+1
    branchz arg_missing
    storea src_ptr
    seta path_buf
    storea dst_ptr
    loadi src_ptr
    branchz arg_missing
copy_arg_loop:
    loada dst_ptr
    cmpm path_end
    branchz copy_arg_done
    loadi src_ptr
    branchz copy_arg_done
    storei dst_ptr
    loada src_ptr
    addi 1
    storea src_ptr
    loada dst_ptr
    addi 1
    storea dst_ptr
    jump copy_arg_loop
copy_arg_done:
    seta 0
    storei dst_ptr
    seta 1
    jumpm arg_ret
arg_missing:
    seta 0
    jumpm arg_ret

mfs_load:
    trap open mfs_image_path 0 0
    brancherr mfs_load_fail
    storea mfs_fd
    trap read A mfs_buf 8192
    brancherr mfs_load_close_fail
    storea mfs_len
    loada mfs_fd
    trap close A
    seta 0
    storea mfs_status
    loada mfs_len
    jumpm mfs_ret
mfs_load_close_fail:
    loada mfs_fd
    trap close A
mfs_load_fail:
    seta 1
    storea mfs_status
    seta 0
    jumpm mfs_ret

mfs_name_matches_path:
    loada mfs_entry_ptr
    storea src_ptr
    seta path_buf
    storea pat_ptr
match_loop:
    loadi src_ptr
    storea tmp_ch
    loadi pat_ptr
    cmpm tmp_ch
    branchz match_chars_equal
match_fail:
    seta 0
    jumpm mfs_match_ret
match_chars_equal:
    loada tmp_ch
    branchz match_success
    loada src_ptr
    addi 1
    storea src_ptr
    loada pat_ptr
    addi 1
    storea pat_ptr
    jump match_loop
match_success:
    seta 1
    jumpm mfs_match_ret

usage_msg:
    ascii "usage: mfscat NAME\n"
usage_msg_end:
failed_msg:
    ascii "mfs.cat: failed\n"
failed_msg_end:
mfs_image_path:
    cstring "/mfs/root.mfs"
path_end:
    word path_buf+511
arg_ret:
    word 0
mfs_fd:
    word 0
mfs_len:
    word 0
mfs_status:
    word 0
mfs_ret:
    word 0
mfs_entry_ptr:
    word 0
mfs_match_ret:
    word 0
src_ptr:
    word 0
pat_ptr:
    word 0
dst_ptr:
    word 0
tmp_ch:
    word 0
out_byte:
    word 0
payload_end:
    word 0
path_buf:
    zero 512
mfs_buf:
    zero 8192

include "../../src/userland/mfs-manifest.m8a"
