start:
    seta after_arg
    storea arg_ret
    jump copy_arg1
after_arg:
    branchz usage
    seta after_load
    storea mfs_ret
    jump mfs_load
after_load:
    loada mfs_status
    branchnz failed
cat_try_0:
    seta mfs_buf+512
    storea mfs_entry_ptr
    seta cat_after_0
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_0:
    branchnz cat_found_0
cat_try_1:
    seta mfs_buf+640
    storea mfs_entry_ptr
    seta cat_after_1
    storea mfs_match_ret
    jump mfs_name_matches_path
cat_after_1:
    branchnz cat_found_1
