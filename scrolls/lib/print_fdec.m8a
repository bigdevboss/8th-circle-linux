    trap read 7 dec_scr 1
    branchz pfd_p1000_d7
    trap read 7 dec_scr 999
    trap read 7 dec_scr 1
    branchz pfd_p1000_d8
    seta 0
    storea dec_leadz
    trap write 1 dec_ch_9 1
    jump pfd_sh1000_9
