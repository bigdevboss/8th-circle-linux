; print_fdec: decimal printing with the kernel as the ALU.
;
; Contract: value arrives in A (0..8192), caller stored the return
; target in print_ret. Drop-in replacement for the old counter-based
; print_dec, with zero friendly arithmetic.
;
; The value becomes a file size with one bounded write (write len = A).
; Each digit position is an ascending cumulative ladder on one fd:
; read(p-1) then read(1) proves at least p bytes remain, and each
; successful rung consumed exactly p bytes. The first failing rung
; means the digit is the previous rung. The remainder is carried to
; the next position by copying the unconsumed bytes into the second
; scratch file. dup2 pins each open fd to a static number; the
; original fd is saved, dup2'd, and closed. Leading zeros are
; suppressed with a flag; a value of zero prints "0" at the end.
print_dec:
    storea dec_val
    seta 1
    storea dec_leadz
    trap open dec_a_path 577 448
    brancherr pfd_fail
    storea pfd_fd
    trap dup2 A 7
    loada pfd_fd
    trap close A
    loada dec_val
    trap write 7 dec_scr A
    trap close 7

pfd_p1000:
    trap open dec_a_path 0 448
    brancherr pfd_fail
    storea pfd_fd
    trap dup2 A 7
    loada pfd_fd
    trap close A
    trap read 7 dec_scr 999
    trap read 7 dec_scr 1
    branchz pfd_p1000_d0
    trap read 7 dec_scr 999
    trap read 7 dec_scr 1
    branchz pfd_p1000_d1
    trap read 7 dec_scr 999
    trap read 7 dec_scr 1
    branchz pfd_p1000_d2
